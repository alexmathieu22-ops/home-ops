{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets#8.1.0',
    ':timezone(America/Toronto)',
    'docker:pinDigests',
    'github>alexmathieu22-ops/home-ops//.renovate/automerge.json5',
    'github>alexmathieu22-ops/home-ops//.renovate/grouping.json5',
    'github>alexmathieu22-ops/home-ops//.renovate/labels.json5',
  ],
  rebaseWhen: 'behind-base-branch',
  packageRules: [
    {
      description: 'The annotated `# renovate: datasource=... depName=...` regex manager has no digest capture group, so pinDigests has nowhere to write the digest and fails the whole branch (see ghcr.io/siderolabs/installer and ghcr.io/siderolabs/kubelet in tuppr upgrades).',
      matchManagers: [
        'custom.regex',
      ],
      pinDigests: false,
    },
  ],
}
