#cloud-config
package_update: true
package_upgrade: true
packages:
  - curl
  - gnupg
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https
  - ufw

runcmd:
  # --- Headscale ---
  - curl -fsSL -o /tmp/headscale.deb "https://github.com/juanfont/headscale/releases/download/v${headscale_version}/headscale_${headscale_version}_linux_amd64.deb"
  - dpkg -i /tmp/headscale.deb

  # --- Caddy (official apt repo) ---
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list
  - apt-get update
  - apt-get install -y caddy

  # --- Headscale config -- written after install so the package's own default doesn't clobber it ---
  - |
    cat > /etc/headscale/config.yaml <<'EOF'
    server_url: https://${headscale_fqdn}
    listen_addr: 127.0.0.1:8080
    metrics_listen_addr: 127.0.0.1:9090

    database:
      type: sqlite
      sqlite:
        path: /var/lib/headscale/db.sqlite

    derp:
      server:
        enabled: true
        region_id: 999
        region_code: "headscale"
        region_name: "Headscale Embedded DERP"
        stun_listen_addr: "0.0.0.0:3478"
      urls: []
      auto_update_enabled: false

    dns:
      magic_dns: true
      base_domain: internal.${root_domain}
    EOF

  # --- Caddy config: TLS is automatic (Let's Encrypt via HTTP-01 on :80) ---
  - |
    cat > /etc/caddy/Caddyfile <<'EOF'
    ${headscale_fqdn} {
        reverse_proxy 127.0.0.1:8080
    }
    EOF

  # --- OS firewall -- defense in depth on top of the OCI security list ---
  - ufw allow OpenSSH
  - ufw allow 443/tcp
  - ufw allow 80/tcp
  - ufw allow 3478/udp
  - ufw --force enable

  # --- Start services ---
  - systemctl enable --now headscale
  - systemctl restart caddy

  # --- One-time user so the runbook's pre-auth-key step has something to target ---
  - headscale users create home-ops || true
