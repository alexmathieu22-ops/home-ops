#cloud-config
package_update: true
package_upgrade: true
packages:
  - curl
  - ufw

runcmd:
  # --- Headscale ---
  - curl -fsSL -o /tmp/headscale.deb "https://github.com/juanfont/headscale/releases/download/v${headscale_version}/headscale_${headscale_version}_linux_amd64.deb"
  - dpkg -i /tmp/headscale.deb

  # --- Headscale config -- written after install so the package's own default doesn't clobber it ---
  - |
    cat > /etc/headscale/config.yaml <<'EOF'
    server_url: https://${headscale_fqdn}
    # Headscale terminates TLS itself (built-in ACME below) -- no reverse proxy. The
    # systemd unit grants CAP_NET_BIND_SERVICE so the non-root headscale user can bind
    # :443 directly.
    listen_addr: 0.0.0.0:443
    metrics_listen_addr: 127.0.0.1:9090

    acme_url: https://acme-v02.api.letsencrypt.org/directory
    tls_letsencrypt_hostname: ${headscale_fqdn}
    tls_letsencrypt_cache_dir: /var/lib/headscale/cache
    tls_letsencrypt_challenge_type: HTTP-01
    tls_letsencrypt_listen: ":http"

    # Required as of this Headscale version -- omitting it is a fatal config error at
    # startup ("headscale now requires a new `noise.private_key_path` field"), even
    # though the key file itself still auto-generates on first run if missing.
    noise:
      private_key_path: /var/lib/headscale/noise_private.key

    # Also required (fatal "no IPv4 or IPv6 prefix configured" otherwise) -- standard
    # Tailscale CGNAT/ULA ranges, must not be changed to anything outside them.
    prefixes:
      v4: 100.64.0.0/10
      v6: fd7a:115c:a1e0::/48

    database:
      type: sqlite
      sqlite:
        path: /var/lib/headscale/db.sqlite

    derp:
      server:
        enabled: true
        region_id: 999
        region_code: "headscale"
        region_name: "Headscale Embedded DERP"
        stun_listen_addr: "0.0.0.0:3478"
        # Also required now, same as noise.private_key_path above (fatal "saving private
        # key to disk at path \"\"" otherwise) -- auto-generated at this path if missing.
        private_key_path: /var/lib/headscale/derp_server_private.key
      urls: []
      auto_update_enabled: false

    dns:
      magic_dns: true
      base_domain: internal.${root_domain}
      # override_local_dns defaults to true, which makes nameservers.global a required
      # fatal-on-missing field ("dns.nameservers.global must be set when
      # dns.override_local_dns is true").
      nameservers:
        global:
          - 1.1.1.1
          - 1.0.0.1
    EOF

  # --- OS firewall -- defense in depth on top of the OCI security list ---
  # Oracle's stock Ubuntu image ships pre-existing iptables rules (ACCEPT only tcp/22,
  # REJECT everything else) that sit ahead of ufw's own chains in INPUT, so ufw's allow
  # rules below would otherwise never get evaluated -- clear those first.
  - iptables -F INPUT
  - iptables -P INPUT ACCEPT
  - netfilter-persistent save
  - ufw allow OpenSSH
  - ufw allow 443/tcp
  - ufw allow 80/tcp
  - ufw allow 3478/udp
  - ufw --force enable

  # --- Start service ---
  - systemctl enable --now headscale

  # --- One-time user so the runbook's pre-auth-key step has something to target ---
  - headscale users create home-ops || true
