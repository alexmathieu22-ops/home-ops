# Talos / talhelper generated secrets & configs — regenerable from talsecret.sops.yaml +
# talconfig.yaml via `talhelper genconfig`, so not committed. talsecret.sops.yaml (the
# SOPS/age-encrypted seed) is NOT ignored — that one IS committed, see .sops.yaml and
# docs/runbooks/cluster-bootstrap.md.
talos/clusterconfig/*
!talos/clusterconfig/.gitkeep
kubeconfig
talosconfig
talos/talsecret.yaml

# OpenTofu
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfvars
!terraform/**/*.tfvars.example

# asdf
.tool-versions.bak

# Local tool caches
.cachebro/

# OS
.DS_Store

# Editors
.idea/
.vscode/

# env
.env
.envrc
