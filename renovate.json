{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":disableDependencyDashboard"],
  "timezone": "America/Toronto",
  "schedule": ["before 6am on monday"],
  "flux": {
    "fileMatch": ["kubernetes/.+\\.ya?ml$"]
  },
  "kubernetes": {
    "fileMatch": ["kubernetes/.+\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["kubernetes/.+\\.ya?ml$"]
  },
  "asdf": {
    "enabled": true,
    "fileMatch": ["^\\.tool-versions$"]
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all Talos/talhelper-related asdf tool bumps together — they need to stay compatible with each other.",
      "matchManagers": ["asdf"],
      "matchPackageNames": ["talosctl", "talhelper"],
      "groupName": "talos tooling"
    },
    {
      "description": "Auto-merge patch-level bumps for infra HelmReleases once CI (kubeconform) passes -- cluster is a personal homelab, low blast radius.",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
